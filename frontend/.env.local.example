# Server-side rewrite target (used by next.config.js)
API_URL=http://localhost:8000

# ---------- Fapshi payment integration ----------
# Find these in your merchant dashboard at https://dashboard.fapshi.com.
# Two header values Fapshi uses on every authenticated API call:
FAPSHI_API_USER=
FAPSHI_API_KEY=
# x-wh-secret header value Fapshi sends on every webhook POST. You set
# this yourself in the Fapshi dashboard's webhook config.
FAPSHI_WEBHOOK_SECRET=
# Optional override. Defaults to https://live.fapshi.com.
# Use https://sandbox.fapshi.com for testing with sandbox keys.
# FAPSHI_BASE_URL=https://live.fapshi.com

# Random unguessable token that's part of the webhook URL path:
# https://prodlyft.com/api/payment/callback/<MCP_CALLBACK_SECRET>
# (Env var keeps the legacy name to avoid renaming the column-stored
# value across deployments — the path secret is provider-agnostic.)
MCP_CALLBACK_SECRET=

# ---------- Auto Blogger ----------
# OpenRouter key for article generation.
OPENROUTER_API_KEY=
# Project-wide default model — used by both the AI scraper (when an
# unknown site needs config inference) and the blogger. Defaults to
# google/gemini-2.5-flash; switch to anthropic/claude-sonnet-4.5 for
# higher-quality long-form posts (~10× the cost).
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional blogger-specific override (wins over OPENROUTER_MODEL). Use
# this if you want a different model for blog posts than for everything
# else.
# OPENROUTER_BLOGGER_MODEL=
# OpenAI key for DALL·E featured-image generation. If unset or the
# configured model isn't available, articles still publish but with no
# featured image and the user gets the 5-token rate instead of 10.
OPENAI_API_KEY=
# Image model — defaults to dall-e-3. Newer OpenAI accounts often need
# gpt-image-1 (DALL·E has been deprecated for new orgs since late 2025).
# Hit /admin/blogger → Health check to see what your account supports.
# OPENAI_IMAGE_MODEL=dall-e-3

# Bearer token Vercel Cron sends on each /api/cron/blog-tick request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---------- Outbound email (ticket notifications) ----------
# SMTP credentials used to email the admin when a user opens / replies
# to a support ticket, and to email the user when an admin replies.
#
# For Gmail (smtp.gmail.com): SMTP_PASS must be an APP PASSWORD, NOT
# the account password. Google blocks raw account passwords for SMTP.
# Generate one at https://myaccount.google.com/apppasswords after you
# enable 2-Step Verification on the account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=prodlyft@gmail.com
SMTP_PASS=
# Optional. Defaults to SMTP_USER. Useful when you authenticate as one
# address but want the From header to be different.
# SMTP_FROM="Prodlyft Support <support@prodlyft.com>"
# Address that receives ticket notifications. Defaults to SMTP_USER.
SUPPORT_EMAIL=prodlyft@gmail.com
