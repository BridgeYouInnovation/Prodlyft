# Server-side rewrite target (used by next.config.js)
API_URL=http://localhost:8000

# ---------- My-CoolPay payment integration ----------
# Find these in your merchant dashboard at my-coolpay.com under Applications.
MCP_PUBLIC_KEY=
# Keep secret. Used to verify callback signatures + sign payouts.
MCP_PRIVATE_KEY=
# Random unguessable token in the callback URL path; the same value the
# dashboard's "URL de callback" ends with — e.g. .../api/payment/callback/<this>.
MCP_CALLBACK_SECRET=
# Optional override; defaults to https://my-coolpay.com/api when unset.
# MCP_BASE_URL=https://my-coolpay.com/api
