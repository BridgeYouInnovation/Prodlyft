# Server-side rewrite target (used by next.config.js)
API_URL=http://localhost:8000

# ---------- My-CoolPay payment integration ----------
# Find these in your merchant dashboard at my-coolpay.com under Applications.
MCP_PUBLIC_KEY=
# Keep secret. Used to verify callback signatures + sign payouts.
MCP_PRIVATE_KEY=
# Random unguessable token in the callback URL path; the same value the
# dashboard's "URL de callback" ends with — e.g. .../api/payment/callback/<this>.
MCP_CALLBACK_SECRET=
# Optional override; defaults to https://my-coolpay.com/api when unset.
# MCP_BASE_URL=https://my-coolpay.com/api

# ---------- Auto Blogger ----------
# OpenRouter key for article generation.
OPENROUTER_API_KEY=
# Project-wide default model — used by both the AI scraper (when an
# unknown site needs config inference) and the blogger. Defaults to
# google/gemini-2.5-flash; switch to anthropic/claude-sonnet-4.5 for
# higher-quality long-form posts (~10× the cost).
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional blogger-specific override (wins over OPENROUTER_MODEL). Use
# this if you want a different model for blog posts than for everything
# else.
# OPENROUTER_BLOGGER_MODEL=
# OpenAI key for DALL·E featured-image generation. If unset or the
# configured model isn't available, articles still publish but with no
# featured image and the user gets the 5-token rate instead of 10.
OPENAI_API_KEY=
# Image model — defaults to dall-e-3. Newer OpenAI accounts often need
# gpt-image-1 (DALL·E has been deprecated for new orgs since late 2025).
# Hit /admin/blogger → Health check to see what your account supports.
# OPENAI_IMAGE_MODEL=dall-e-3

# Bearer token Vercel Cron sends on each /api/cron/blog-tick request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
